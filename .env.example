# PostgreSQL connection used by backend/app/database.py
DB_USER=aisdb
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=25432
DB_NAME=aisdb

# 可选：新闻图片根目录（其下包含 images/）；留空时使用仓库上一级的 news_raw_data
NEWS_IMAGE_ROOT=

# 受限 Text-to-SQL 独立只读连接（SQL-02/04；默认关闭）
# 密码仅由 DBA 在运行环境配置，禁止写入 Git 或迁移脚本。
AGENT_QUERY_ENABLED=false
# 未增加认证和限流前仅允许回环地址；SQL-05 接入时必须与实际服务绑定地址一致。
AGENT_QUERY_BIND_HOST=127.0.0.1
AGENT_DB_USER=agent_reader_login
AGENT_DB_PASSWORD=CHANGE_ME
AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=25432
AGENT_DB_NAME=aisdb

# 智能体模型 API（DeepSeek），仅后端运行环境使用，不进入前端/日志/回答
DEEPSEEK_API_KEY=
# 可选，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=
# 可选，默认 deepseek-chat
DEEPSEEK_MODEL=
