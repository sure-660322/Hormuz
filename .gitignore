/data/ship_data/*.csv
/data/crossing_data/transit_events.csv

# Retired simulated bulk output. Historical reports and generator inputs remain tracked.
/sim_ais_demo/output/positions_by_date/
/sim_ais_demo/output/raw_observations/
/sim_ais_demo/output_news_aligned/positions_by_date/
/sim_ais_demo/output_news_aligned/raw_observations/
