# Copy to deploy/handoff.env and replace the password locally.
DB_USER=hormuz
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=25433
DB_NAME=hormuz_handoff

# 智能体模型 API（DeepSeek），仅后端运行环境使用，不进入前端/日志/回答
DEEPSEEK_API_KEY=
# 可选，默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=
# 可选，默认 deepseek-chat
DEEPSEEK_MODEL=
