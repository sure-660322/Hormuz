# Generated safely as .env.server by deploy/server/configure.sh.
DB_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
# Default: host-local entry, for an existing HTTPS proxy or SSH tunnel.
BIND_IP=127.0.0.1
HTTP_PORT=8088
# Optional; no key means the map works but model chat is unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
