# 底图瓦片服务地址（可选）
# 本地自建服务：先运行 scripts/download_tiles.py 下载瓦片，再运行 deploy/tiles/start-tile-server.ps1
VITE_TILE_URL=http://localhost:8080/tiles/{z}/{x}/{y}.png
# 自建瓦片使用 OSM 官方样式时无需设置署名（代码里默认 © OpenStreetMap）；
# 若换用其他瓦片源（如 CARTO），在此补上对应署名
# VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors © CARTO
# 自建瓦片目前下载到 z12；取消注释可放宽（前提是对应层级已下载）
# VITE_TILE_MAX_ZOOM=12
